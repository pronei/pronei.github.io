{
  "ci": {
    "collect": {
      "staticDistDir": "./public",
      "url": ["http://localhost/", "http://localhost/about/", "http://localhost/projects/", "http://localhost/contact/"],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 3000, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }],
        "total-byte-weight": ["error", { "maxNumericValue": 600000, "aggregationMethod": "median-run" }],
        "color-contrast": "error"
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./.lighthouseci" }
  }
}
