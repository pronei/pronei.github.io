{
  // Type-check only. Hugo's js.Build (esbuild) does the actual bundling and strips types
  // without checking them, so CI runs `tsc -p .` (see .github/workflows/hugo.yml).
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["assets/js/**/*.ts"]
}
